{
  "name": "learn-dsh",
  "version": "0.6.0",
  "private": true,
  "description": "用可运行实验逐步学习 DeepSeek Harness 的非官方中文课程",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linzi007/learn-dsh.git"
  },
  "homepage": "https://github.com/linzi007/learn-dsh#readme",
  "bugs": {
    "url": "https://github.com/linzi007/learn-dsh/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "demo:s01": "tsx s01_lifecycle_microscope/src/demo.ts",
    "demo:s02": "tsx s02_service_seam/src/demo.ts",
    "demo:s03": "tsx s03_append_only_session/src/demo.ts",
    "demo:s04": "tsx s04_projection_replay/src/demo.ts",
    "demo:s05": "tsx s05_tool_contract/src/demo.ts",
    "demo:s06": "pnpm run demo:s06:real",
    "demo:s06:real": "node --env-file-if-exists=.env --import tsx s06_keyless_agent_loop/src/real-demo.ts",
    "demo:s06:keyless": "tsx s06_keyless_agent_loop/src/demo.ts",
    "demo:s07": "tsx s07_permission/src/demo.ts",
    "demo:s08": "tsx s08_jsonl_persistence/src/demo.ts",
    "demo:s09": "tsx s09_background_jobs/src/demo.ts",
    "demo:s10": "tsx s10_compaction/src/demo.ts",
    "demo:s11": "tsx s11_mcp_bridge/src/demo.ts",
    "demo:s12": "tsx s12_subagent_workflow/src/demo.ts",
    "demo:s13": "tsx s13_capstone/src/demo.ts",
    "demo:all": "pnpm run demo:s01 && pnpm run demo:s02 && pnpm run demo:s03 && pnpm run demo:s04 && pnpm run demo:s05 && pnpm run demo:s06:keyless && pnpm run demo:s07 && pnpm run demo:s08 && pnpm run demo:s09 && pnpm run demo:s10 && pnpm run demo:s11 && pnpm run demo:s12 && pnpm run demo:s13",
    "lint": "oxlint s*/src s*/tests tests vitest.config.ts --deny-warnings",
    "test": "vitest run",
    "test:s01": "vitest run s01_lifecycle_microscope/tests",
    "test:s02": "vitest run s02_service_seam/tests",
    "test:s03": "vitest run s03_append_only_session/tests",
    "test:s04": "vitest run s04_projection_replay/tests",
    "test:s05": "vitest run s05_tool_contract/tests",
    "test:s06": "vitest run s06_keyless_agent_loop/tests",
    "test:s07": "vitest run s07_permission/tests",
    "test:s08": "vitest run s08_jsonl_persistence/tests",
    "test:s09": "vitest run s09_background_jobs/tests",
    "test:s10": "vitest run s10_compaction/tests",
    "test:s11": "vitest run s11_mcp_bridge/tests",
    "test:s12": "vitest run s12_subagent_workflow/tests",
    "test:s13": "vitest run s13_capstone/tests",
    "typecheck": "tsc --noEmit",
    "check:course": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs-observation-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-jobs-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tool-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workflow-worker-thread": "0.1.1-rc.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "oxlint": "1.76.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
